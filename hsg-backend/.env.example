# Runtime connects as the restricted app role (INSERT/SELECT only on journal tables)
DATABASE_URL=postgresql://hsg_app:hsg_app@localhost:5432/hsg
# Migrations connect as the owner
MIGRATE_DATABASE_URL=postgresql://hsg_owner:hsg_owner@localhost:5432/hsg
TEST_DATABASE_URL=postgresql://hsg_app:hsg_app@localhost:5432/hsg_test
TEST_MIGRATE_DATABASE_URL=postgresql://hsg_owner:hsg_owner@localhost:5432/hsg_test
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-only-change-me
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Chain: local anvil by default. Switch to Base Sepolia by changing RPC_URL/CHAIN_ID and chain.local.json keys.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
EXPLORER_TX_URL=
CHAIN_CONFIG_PATH=./chain.local.json
# Payout partner: SIMULATED (default) | BRIDGE (stub; needs sandbox keys)
PAYOUT_PARTNER=SIMULATED
BRIDGE_API_URL=
BRIDGE_API_KEY=
