{
  "name": "hsg-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start:api": "nest start --entryFile main",
    "dev:api": "nest start --watch --entryFile main",
    "start:worker": "node dist/worker.js",
    "dev:worker": "nest start --watch --entryFile worker",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "db:seed": "ts-node prisma/seed.ts",
    "chain:up": "anvil --port 8545 --block-time 2 --mnemonic 'test test test test test test test test test test test junk'",
    "chain:deploy": "ts-node contracts/deploy.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "load": "ts-node load/run.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.56.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "ioredis": "^5.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "solc": "0.8.26",
    "ulid": "^3.0.1",
    "viem": "^2.33.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.16.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.0.0",
    "prisma": "^6.16.0",
    "supertest": "^7.1.3",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
