# Railway image for the API and the saga worker (build context = repo root).
# ROLE=api (default): scripts/start-api.sh (app role, migrations, grants), then serve the API on $PORT.
# ROLE=worker: run the BullMQ saga worker (no HTTP).
FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY hsg-backend/package.json hsg-backend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY hsg-backend/prisma ./prisma
RUN npx prisma generate
COPY hsg-backend/ ./
RUN npx nest build
ENV NODE_ENV=production
CMD ["sh", "-c", "if [ \"$ROLE\" = worker ]; then exec node dist/worker.js; else exec sh scripts/start-api.sh; fi"]
